{
  "name": "kid-closet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Outfit picker PWA for kids. Runs fully on the iPhone; photos are stored as local WebP files.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "fflate": "0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
